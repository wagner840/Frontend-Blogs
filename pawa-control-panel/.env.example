# =============================================================================
# PAWA Control Panel - Environment Variables Configuration
# =============================================================================
# Copy this file to .env.local and fill in your actual values
# Never commit .env.local to version control!

# =============================================================================
# SUPABASE CONFIGURATION
# =============================================================================
# Get these values from your Supabase project dashboard
# Dashboard: https://supabase.com/dashboard/project/[your-project-id]/settings/api

# Public Supabase URL (safe to expose to client-side)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co

# Public anon key (safe to expose to client-side)
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your-anon-key

# Service role key (NEVER expose to client-side, server-only)
# Used for admin operations like WordPress sync and OAuth token management
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your-service-role-key

# =============================================================================
# WORDPRESS BLOG CONFIGURATION
# =============================================================================
# Configure up to 3 WordPress blogs for content synchronization
# Create application passwords in WordPress: WP Admin > Users > Application Passwords

# Blog 1 Configuration
WORDPRESS_BLOG1_URL=https://your-first-blog.com
WORDPRESS_BLOG1_USERNAME=your-wp-username-1
WORDPRESS_BLOG1_PASSWORD=your-wp-app-password-1

# Blog 2 Configuration
WORDPRESS_BLOG2_URL=https://your-second-blog.com
WORDPRESS_BLOG2_USERNAME=your-wp-username-2
WORDPRESS_BLOG2_PASSWORD=your-wp-app-password-2

# Blog 3 Configuration
#WORDPRESS_BLOG3_URL=https://your-third-blog.com
#WORDPRESS_BLOG3_USERNAME=your-wp-username-3
#WORDPRESS_BLOG3_PASSWORD=your-wp-app-password-3

# =============================================================================
# GOOGLE ANALYTICS & OAUTH2 CONFIGURATION
# =============================================================================
# Set up Google Cloud Console project and enable Google Analytics Reporting API
# Console: https://console.cloud.google.com/

# OAuth2 Client credentials from Google Cloud Console
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=GOCSPX-your-google-client-secret

# Google Analytics 4 Property ID (found in GA4 Admin > Property Settings)
# Format: numbers only, e.g., 123456789
GOOGLE_ANALYTICS_PROPERTY_ID=123456789

# =============================================================================
# NEXTAUTH CONFIGURATION
# =============================================================================
# NextAuth secret - generate with: openssl rand -base64 32
NEXTAUTH_SECRET=your-super-secret-32-character-string-here

# Base URL for your application (used for OAuth redirects)
NEXTAUTH_URL=http://localhost:3000

# =============================================================================
# DEVELOPMENT CONFIGURATION
# =============================================================================
# Set to production for production builds
NODE_ENV=development

# =============================================================================
# SETUP INSTRUCTIONS
# =============================================================================

# 1. SUPABASE SETUP:
#    - Create a new project at https://supabase.com
#    - Copy the URL and keys from Project Settings > API
#    - Run the database migrations using the Supabase MCP tools

# 2. WORDPRESS SETUP:
#    - Go to each WordPress site: WP Admin > Users > Your Profile
#    - Scroll to "Application Passwords" section
#    - Create new application password with name "PAWA Control Panel"
#    - Use the generated password (not your regular login password)
#    - Configure webhook endpoints to point to your app's /api/sync/wordpress

# 3. GOOGLE ANALYTICS SETUP:
#    - Create project in Google Cloud Console
#    - Enable Google Analytics Reporting API
#    - Create OAuth2 credentials (Web application)
#    - Add authorized redirect URI: http://localhost:3000/api/auth/google/callback
#    - Get your GA4 Property ID from Google Analytics Admin panel

# 4. SECURITY NOTES:
#    - Never commit .env.local to version control
#    - Use strong, unique passwords for WordPress application passwords
#    - Regularly rotate your Google client secret
#    - Keep your Supabase service role key secure (server-side only)

# 5. WEBHOOK CONFIGURATION:
#    WordPress webhook URL: https://yourdomain.com/api/sync/wordpress
#    Authentication: Basic Auth using WordPress credentials above
#    Triggers: Post published, Post updated, Post deleted

# =============================================================================
# PRODUCTION DEPLOYMENT
# =============================================================================
# For production deployment:
# 1. Update NEXTAUTH_URL to your production domain
# 2. Add production domain to Google OAuth2 authorized origins
# 3. Update WordPress webhook URLs to production endpoints
# 4. Use HTTPS for all URLs in production
# 5. Consider using environment variable management service (Vercel, Netlify, etc.)